# ─────────────────────────────────────────────────────────────
# VOLTA · Variables de entorno
# Copia este archivo como .env.local y llena los valores.
# .env.local NUNCA se sube al repositorio (está en .gitignore).
# En Vercel: Project → Settings → Environment Variables.
# ─────────────────────────────────────────────────────────────

# URL pública del sitio (sin barra final). Se usa en metadatos, sitemap y enlaces absolutos.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ── Supabase ──
# Supabase → Project Settings → API Keys.
# Sin estas dos variables, la tienda usa el catálogo de EJEMPLO.
NEXT_PUBLIC_SUPABASE_URL=
# Clave publicable (empieza por sb_publishable_). Es segura en el navegador: la protege la RLS.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Clave secreta (empieza por sb_secret_). SOLO servidor: salta la RLS. Nunca con prefijo NEXT_PUBLIC_.
SUPABASE_SECRET_KEY=

# ── Wompi (Fase 6b, aún sin configurar) ──
# WOMPI_PUBLIC_KEY=
# WOMPI_PRIVATE_KEY=
# WOMPI_EVENTS_SECRET=
# WOMPI_INTEGRITY_SECRET=

# ── Correo transaccional (Fase 6b) ──
# RESEND_API_KEY=
